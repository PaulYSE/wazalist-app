{
	"name": "wazalist-app",
	"description": "Cloudflare's native serverless SQL database.",
	"cloudflare": {
		"label": "Worker + D1 Database",
		"products": [
			"Workers",
			"D1"
		],
		"categories": [
			"storage"
		],
		"docs_url": "https://developers.cloudflare.com/d1/",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/6c63cca8-354a-4951-45a0-d58769ac6f00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/aa6158f1-7711-4485-f134-a8c802c0a800/preview",
		"publish": true
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"concurrently": "^10.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.16.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "5.9.3",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"predeploy": "wrangler d1 migrations apply DB --remote",
		"seedLocalD1": "wrangler d1 migrations apply DB --local",
		"dev:seed": "wrangler d1 migrations apply DB --local",
		"dev:worker": "wrangler dev",
		"dev:worker:remote": "wrangler dev --remote",
		"dev:ui": "vite",
		"dev": "npm run dev:seed && concurrently \"npm run dev:worker\" \"npm run dev:ui\"",
		"dev:remote": "concurrently \"npm run dev:worker:remote\" \"npm run dev:ui\"",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint public/js",
		"lint:fix": "eslint public/js --fix",
		"format": "prettier --write \"public/**/*.{js,css,html}\""
	}
}
